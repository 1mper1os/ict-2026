---
// AboutUs.astro - Sakura Expeditions
const stats = [
  { number: "10+", label: "Years of experience", icon: "award" },
  { number: "12,000+", label: "Happy travelers", icon: "users" },
  { number: "4.8★", label: "Average rating", icon: "star" },
  { number: "98%", label: "Customer satisfaction", icon: "heart" }
];
---

<section class="about-section" id="sobre-nosotros">
  <!-- Hero About -->
  <div class="about-hero">
    <div class="hero-background">
      <img src="/grupal2026.jpg" alt="Sakura Expeditions Team" />
      <div class="hero-overlay"></div>
    </div>
    
    <div class="container">
      <div class="hero-content">
        <span class="hero-badge">Since 2015</span>
        <h1 class="hero-title">
          About <span class="highlight">Sakura Expeditions</span>
        </h1>
        <p class="hero-subtitle">
          Where adventure and culture come together to create unforgettable memories.
        </p>
      </div>
    </div>
  </div>

  <!-- Nuestra Historia -->
  <div class="story-section">
    <div class="container">
      <div class="story-grid">
        <div class="story-image">
          <div class="image-wrapper">
            <img src="/grupal2026.jpg" alt="Equipo Sakura" />
            <div class="image-badge">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
              <span>2024 Award Winners</span>
            </div>
          </div>
        </div>

        <div class="story-content">
          <span class="section-badge">Our History</span>
          <h2 class="section-title">
            Passion for Adventure <br />
            <span class="highlight">From Day One</span>
          </h2>
          
          <div class="story-text">
            <p>
              Founded in 2015, <strong>Sakura Expeditions</strong> was born from the dream of sharing the magic of the Peruvian Andes with travelers from around the world. What began as a small family business has grown to become one of the most trusted and respected operators in Cusco.
            </p>
            <p>
              Our name, <em>Sakura</em> (cherry blossom in Japanese), symbolizes the fleeting and precious beauty of every moment on the mountain. Every trek is unique, every sunrise unrepeatable, and we strive to make each experience as memorable as the cherry blossom itself.
            </p>
            <p>
              With over 10 years of experience, we've guided more than 12,000 adventurers along the Inca Trails, sharing not only routes but also stories, culture, and moments that will last a lifetime.
            </p>
          </div>

          <!-- Mission & Vision -->
          <div class="mission-vision">
            <div class="mission-box">
              <div class="box-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 16v-4"></path>
                  <path d="M12 8h.01"></path>
                </svg>
              </div>
              <div>
                <h3>Mission</h3>
                <p>Offering authentic and safe experiences, connecting travelers with the magnificence of the Andes and the rich Peruvian culture.</p>
              </div>
            </div>
            
            <div class="mission-box">
              <div class="box-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
              </div>
              <div>
                <h3>Vision</h3>
                <p>To be leaders in sustainable tourism in Peru, recognized for our excellence, environmental responsibility, and social commitment.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Counter -->
  <div class="stats-section">
    <div class="container">
      <div class="stats-grid">
        {stats.map((stat) => (
          <div class="stat-card">
            <div class="stat-icon">
              {stat.icon === 'award' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="8" r="7"></circle>
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                </svg>
              )}
              {stat.icon === 'users' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              )}
              {stat.icon === 'star' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              )}
              {stat.icon === 'heart' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              )}
            </div>
            <div class="stat-number">{stat.number}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background: var(--cream);
  }

  /* Hero About */
  .about-hero {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(10, 15, 29, 0.9) 0%,
      rgba(0, 43, 79, 0.85) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 4rem 2rem;
  }

  .hero-badge {
    display: inline-block;
    background: var(--gold);
    color: white;
    padding: 0.6rem 1.5rem;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 4px 15px rgba(203, 153, 52, 0.3);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: white;
    margin-bottom: 1rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero-title .highlight {
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: rgba(255, 255, 255, 0.95);
    font-weight: 300;
    max-width: 700px;
    margin: 0 auto;
  }

  /* Story Section */
  .story-section {
    padding: 6rem 0;
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-2) 100%);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .story-image {
    position: relative;
  }

  .image-wrapper {
    position: relative;
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(10, 15, 29, 0.15);
  }

  .image-wrapper img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    display: block;
  }

  .image-badge {
    position: absolute;
    bottom: 30px;
    right: 30px;
    background: linear-gradient(135deg, var(--gold), var(--clay));
    color: #fff;
    padding: 1rem 1.5rem;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 700;
  }

  .story-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-badge {
    display: inline-block;
    color: var(--clay);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--ink);
    line-height: 1.2;
  }

  .section-title .highlight {
    background: linear-gradient(135deg, var(--clay), var(--gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .story-text {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .story-text p {
    color: #555;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .story-text strong {
    color: var(--ink);
    font-weight: 700;
  }

  .story-text em {
    color: var(--clay);
    font-style: italic;
  }

  /* Mission Vision */
  .mission-vision {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mission-box {
    background: linear-gradient(135deg, var(--cream-2), white);
    padding: 2rem;
    border-radius: 20px;
    border-left: 4px solid var(--clay);
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    box-shadow: 0 4px 15px rgba(10, 15, 29, 0.05);
  }

  .box-icon {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, var(--clay), var(--gold));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: white;
  }

  .mission-box h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .mission-box p {
    color: #666;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Stats Section */
  .stats-section {
    padding: 5rem 0;
    background: linear-gradient(135deg, var(--night) 0%, var(--navy) 100%);
    position: relative;
    overflow: hidden;
  }

  .stats-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 85% 20%, rgba(203, 153, 52, 0.08), transparent 45%);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
    position: relative;
    z-index: 1;
  }

  .stat-card {
    text-align: center;
    color: white;
  }

  .stat-icon {
    width: 70px;
    height: 70px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    color: var(--gold-light);
    transition: all 0.3s ease;
  }

  .stat-card:hover .stat-icon {
    transform: translateY(-5px) scale(1.1);
    background: rgba(255, 255, 255, 0.15);
  }

  .stat-number {
    font-size: 3rem;
    font-weight: 900;
    color: var(--gold-light);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    font-weight: 500;
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .story-grid {
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .story-image {
      order: -1;
    }

    .image-wrapper img {
      height: 400px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .about-hero {
      min-height: 40vh;
    }

    .hero-content {
      padding: 3rem 1rem;
    }

    .stats-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .stat-number {
      font-size: 2.5rem;
    }
  }
</style>