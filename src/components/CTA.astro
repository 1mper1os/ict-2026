---
// CTA.astro - Sección CTA final con fondo oscuro
---

<section class="cta" id="reservar">
  <div class="container">
    <span class="cta-eyebrow">Limited spots 2027</span>
    <h2>Your Inca Trail adventure starts here</h2>
    <p>Inca Trail permits are limited and sell out months in advance. Secure your date and travel with those who know every step of the trail.</p>
    <div class="cta-actions">
      <a href="https://wa.me/51984573283?text=Hello%20Sakura%20Expeditions%2C%20I%20want%20to%20book%20a%20tour" class="btn-primary" target="_blank">
        Book Now
        <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="https://wa.me/51984573283?text=Hello%20Sakura%20Expeditions%2C%20I%20have%20a%20question" class="btn-outline" target="_blank">Chat on WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding: 120px 0;
    text-align: center;
    background:
      linear-gradient(180deg, rgba(0, 26, 51, 0.92) 0%, rgba(10, 15, 29, 0.97) 100%),
      url("https://images.unsplash.com/photo-1587595431973-160d0d94add1?q=80&w=1920&auto=format&fit=crop");
    background-size: cover;
    background-position: center;
  }

  .cta-eyebrow {
    color: var(--gold-light);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 18px;
    display: block;
  }

  .cta h2 {
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -1px;
    color: #fff;
    max-width: 680px;
    margin: 0 auto 18px;
  }

  .cta p {
    color: #cbd5e1;
    font-size: 1rem;
    max-width: 520px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--gold);
    color: var(--navy-dark);
    font-weight: 800;
    font-size: 0.95rem;
    padding: 16px 30px;
    border-radius: 40px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.25s ease, background 0.25s ease;
    box-shadow: 0 12px 28px rgba(203, 153, 52, 0.25);
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    background: var(--gold-light);
  }

  .btn-primary svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 2.5;
    fill: none;
  }

  .btn-outline {
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #fff;
    padding: 16px 30px;
    border-radius: 40px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.25s;
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.08);
  }
</style>