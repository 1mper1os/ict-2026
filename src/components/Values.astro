---
// Values.astro - Sakura Expeditions
const valores = [
  {
    icon: "shield",
    titulo: "Guaranteed Safety",
    descripcion: "Your safety is our priority. Strict protocols and travel insurance included."
  },
  {
    icon: "leaf",
    titulo: "Sustainable Tourism",
    descripcion: "Committed to the environment and local communities."
  },
  {
    icon: "users",
    titulo: "Small Groups",
    descripcion: "Personalized experiences with dedicated attention for each traveler."
  },
  {
    icon: "certificate",
    titulo: "Certified Guides",
    descripcion: "Expert professionals with extensive knowledge of history and culture."
  }
];
---

<section class="values-section" id="valores">
  <div class="container">
    <div class="section-header-center reveal">
      <span class="section-badge">What defines us</span>
      <h2 class="section-title">
        Our <span class="highlight">Values</span>
      </h2>
      <p class="section-description">
        Principles that guide every expedition and every decision we make
      </p>
    </div>

    <div class="valores-grid">
      {valores.map((valor) => (
        <div class="valor-card reveal">
          <div class="valor-icon">
            {valor.icon === 'shield' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            )}
            {valor.icon === 'leaf' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
              </svg>
            )}
            {valor.icon === 'users' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            )}
            {valor.icon === 'certificate' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="10" r="8"></circle>
                <path d="M12 2v8"></path>
                <path d="M12 18v4"></path>
                <path d="m4.93 4.93 4.24 4.24"></path>
                <path d="m14.83 14.83 4.24 4.24"></path>
                <path d="M2 12h8"></path>
                <path d="M14 12h8"></path>
                <path d="m4.93 19.07 4.24-4.24"></path>
                <path d="m14.83 9.17 4.24-4.24"></path>
              </svg>
            )}
          </div>
          <h3 class="valor-titulo">{valor.titulo}</h3>
          <p class="valor-descripcion">{valor.descripcion}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .values-section {
    padding: 6rem 0;
    background: white;
  }

  .section-header-center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem;
  }

  .section-badge {
    display: inline-block;
    color: var(--clay);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--ink);
    line-height: 1.2;
  }

  .section-title .highlight {
    background: linear-gradient(135deg, var(--clay), var(--gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-description {
    color: #666;
    font-size: 1.1rem;
    line-height: 1.7;
    margin-top: 1rem;
  }

  .valores-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .valor-card {
    background: linear-gradient(135deg, var(--cream-2), white);
    padding: 2.5rem 2rem;
    border-radius: 20px;
    text-align: center;
    transition: all 0.4s ease;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .valor-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(10, 15, 29, 0.1);
    border-color: var(--gold);
  }

  .valor-icon {
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, var(--gold), var(--clay));
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    color: white;
    transition: all 0.3s ease;
  }

  .valor-card:hover .valor-icon {
    transform: rotateY(360deg);
  }

  .valor-titulo {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 0.8rem;
  }

  .valor-descripcion {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .valores-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .valores-grid {
      grid-template-columns: 1fr;
    }
  }
</style>