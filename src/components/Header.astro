---
// Header.astro - Nav fijo con marca Sakura Expeditions
---

<nav class="nav">
  <div class="container nav-inner">
    <div class="brand">
      <img src="/logo9.png" alt="Sakura Expeditions" class="brand-logo" />
    </div>
    <div class="nav-links" id="navLinks">
      <a href="#inicio">Home</a>
      <a href="#paquetes">Routes</a>
      <a href="#nosotros">About</a>
      <a href="#contacto">Contact</a>
      <a href="#blog">Blog</a>
      <a href="#reservar" class="nav-cta">Book Now</a>
    </div>
    <button class="menu-toggle" aria-label="Open menu" id="menuBtn">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 24px 0;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-logo {
    width: 160px;
    height: auto;
    object-fit: cover;
  }

  .brand-text {
    font-family: 'Korolev', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.3px;
    color: #fff;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #e2e8f0;
  }

  .nav-links a {
    opacity: 0.85;
    transition: opacity 0.25s;
  }

  .nav-links a:hover {
    opacity: 1;
  }

  .nav-cta {
    background: var(--gold) !important;
    color: var(--navy-dark) !important;
    padding: 10px 20px !important;
    border-radius: 30px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.2px;
    opacity: 1 !important;
    transition: transform 0.25s, background 0.25s;
  }

  .nav-cta:hover {
    transform: translateY(-2px);
    background: var(--gold-light) !important;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    gap: 5px;
  }

  .menu-toggle span {
    width: 25px;
    height: 3px;
    background: white;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: rgba(10, 15, 29, 0.97);
      flex-direction: column;
      padding: 24px;
      gap: 18px;
      backdrop-filter: blur(12px);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .nav-links.active {
      display: flex;
    }

    .menu-toggle {
      display: flex;
    }
  }
</style>
