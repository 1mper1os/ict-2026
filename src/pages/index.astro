---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Paquetes from '../components/Paquetes.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import BeneficiosNew from '../components/BeneficiosNew.astro';
import AboutUs from '../components/AboutUs.astro';
import Values from '../components/Values.astro';
import Certifications from '../components/Certifications.astro';
import BlogNew from '../components/BlogNew.astro';
import CTA from '../components/CTA.astro';
import FooterNew from '../components/FooterNew.astro';
---

<Layout title="Sakura Expeditions — Inca Trail 2027">
  <Header />
  <Hero />
  <Paquetes />
  <WhyChooseUs />
  <BeneficiosNew />
  <AboutUs />
  <Values />
  <Certifications />
  <BlogNew />
  <CTA />
  <FooterNew />
</Layout>

<script>
  // Scroll reveal con Intersection Observer
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>